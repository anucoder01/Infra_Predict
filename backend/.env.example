# Persistent storage: SQLite default, or PostgreSQL/TimescaleDB URL
DATABASE_URL=sqlite:///./backend/infrapredict.db
# DATABASE_URL=postgresql://user:password@localhost:5432/infrapredict

# Optional MQTT telemetry subscriber
MQTT_BROKER=
MQTT_PORT=1883
MQTT_TOPIC=infrapredict/+/telemetry
MQTT_USERNAME=
MQTT_PASSWORD=
INGEST_URL=http://127.0.0.1:8001/api/ingest

# Optional bridge damage segmentation model
INFRAPREDICT_VISION_MODEL=
INFRAPREDICT_VISION_INPUT_SIZE=640
INFRAPREDICT_VISION_CONFIDENCE=0.25
INFRAPREDICT_VISION_CLASSES=crack,spalling
